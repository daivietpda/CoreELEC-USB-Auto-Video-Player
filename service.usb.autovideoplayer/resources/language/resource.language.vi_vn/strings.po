msgctxt "#30000"
msgid "General"
msgstr "Cài đặt chung"

msgctxt "#30001"
msgid "Enable USB Auto Video Player"
msgstr "Bật USB Auto Video Player"

msgctxt "#30002"
msgid "Auto play when USB inserted"
msgstr "Tự động phát khi cắm USB"

msgctxt "#30003"
msgid "Playback mode"
msgstr "Chế độ phát"

msgctxt "#30004"
msgid "Auto play single video and loop"
msgstr "Tự động phát 1 video và lặp lại"

msgctxt "#30005"
msgid "Auto play all videos and loop"
msgstr "Tự động phát tất cả video và lặp lại"

msgctxt "#30006"
msgid "Manual video selection"
