msgctxt "#30013"
msgid "Repeat playback"
msgstr "Lặp lại video/playlist"

msgctxt "#30014"
msgid "Delay after USB detected"
msgstr "Thời gian chờ sau khi phát hiện USB"

msgctxt "#30015"
msgid "0 seconds"
msgstr "0 giây"

msgctxt "#30016"
msgid "1 second"
msgstr "1 giây"

msgctxt "#30017"
msgid "2 seconds"
msgstr "2 giây"

msgctxt "#30018"
msgid "3 seconds"
msgstr "3 giây"

msgctxt "#30019"
msgid "5 seconds"
msgstr "5 giây"

msgctxt "#30020"
msgid "10 seconds"
msgstr "10 giây"

msgctxt "#30021"
msgid "Show notifications"
msgstr "Hiển thị thông báo"

msgctxt "#30022"
msgid "Debug logging"
msgstr "Ghi log chi tiết"

msgctxt "#30030"
msgid "USB Auto Video Player"
msgstr "USB Auto Video Player"

msgctxt "#30031"
msgid "No USB drive detected"
msgstr "Không tìm thấy USB nào đang cắm"

msgctxt "#30032"
msgid "No video files found on USB"
msgstr "Không tìm thấy video trên USB"

msgctxt "#30033"
msgid "USB detected: %s"
msgstr "Phát hiện USB: %s"

msgctxt "#30034"
msgid "USB removed. Stopping playback"
msgstr "Đã rút USB. Dừng phát video"

msgctxt "#30035"
msgid "Found %d video(s). Starting playback..."
msgstr "Tìm thấy %d video. Bắt đầu phát..."

msgctxt "#30036"
msgid "1. Select Videos for Manual Mode (Mode 3)"
msgstr "1. Chọn video cho Chế độ Thủ công (Mode 3)"

msgctxt "#30037"
msgid "2. Play now from USB (Start Playback)"
msgstr "2. Phát video ngay từ USB (Bắt đầu phát)"

msgctxt "#30038"
msgid "3. Open Add-on Settings"
msgstr "3. Mở Cài đặt Add-on"

msgctxt "#30039"
msgid "Select video(s) for Manual Mode (Mode 3)"
msgstr "Chọn video cho Chế độ Thủ công (Mode 3)"

msgctxt "#30040"
msgid "Selected video(s) saved: %d"
msgstr "Đã lưu %d video đã chọn"

msgctxt "#30041"
msgid "Please insert USB before selecting videos"
msgstr "Vui lòng cắm USB trước khi chọn video"

msgctxt "#30042"
msgid "Select USB Drive"
msgstr "Chọn thiết bị USB"

msgctxt "#30043"
msgid "Mode 3 active: No videos configured in settings"
msgstr "Chế độ 3: Chưa chọn video nào trong cài đặt"

msgctxt "#30044"
msgid "Selected videos not found on this USB"
msgstr "Không tìm thấy video đã chọn trên USB này"

msgctxt "#30045"
msgid "Playing %d selected video(s)"
msgstr "Phát %d video đã chọn"

msgctxt "#30046"
msgid "Scanning and starting playback from USB..."
msgstr "Đang quét và bắt đầu phát video từ USB..."

msgctxt "#30050"
msgid "HLS Stream"
msgstr "Luồng trực tuyến (HLS)"

msgctxt "#30051"
msgid "Enable HLS stream"
msgstr "Bật luồng trực tuyến HLS"

msgctxt "#30052"
msgid "HLS Stream URL"
msgstr "Địa chỉ luồng HLS (.m3u8)"

msgctxt "#30053"
msgid "Source priority"
msgstr "Chế độ ưu tiên nguồn phát"

msgctxt "#30054"
msgid "HLS First (Fallback to USB)"
msgstr "Ưu tiên HLS (Chuyển sang USB khi offline)"

msgctxt "#30055"
msgid "USB First (Fallback to HLS)"
msgstr "Ưu tiên USB (Chuyển sang HLS khi không có USB)"

msgctxt "#30056"
msgid "HLS Only"
msgstr "Chỉ phát luồng HLS"

msgctxt "#30057"
msgid "Retry interval when offline"
msgstr "Thời gian thăm dò lại khi luồng offline"

msgctxt "#30058"
msgid "10 seconds"
msgstr "10 giây"

msgctxt "#30059"
msgid "15 seconds"
msgstr "15 giây"

msgctxt "#30060"
msgid "30 seconds"
msgstr "30 giây"

msgctxt "#30061"
msgid "60 seconds"
msgstr "60 giây"

msgctxt "#30062"
msgid "Connection timeout"
msgstr "Thời gian chờ kết nối tối đa"

msgctxt "#30063"
msgid "2 seconds"
msgstr "2 giây"

msgctxt "#30064"
msgid "3 seconds"
msgstr "3 giây"

msgctxt "#30065"
msgid "5 seconds"
msgstr "5 giây"

msgctxt "#30066"
msgid "HLS stream is online: Starting playback"
msgstr "Luồng HLS hoạt động: Bắt đầu phát"

msgctxt "#30067"
msgid "HLS stream is offline or unreachable"
msgstr "Luồng HLS không hoạt động hoặc mất mạng"

msgctxt "#30068"
msgid "Switching to USB video fallback"
msgstr "Tự động chuyển sang phát video từ USB"

msgctxt "#30069"
msgid "4. Play HLS Stream now"
msgstr "4. Phát ngay luồng HLS"

msgctxt "#30070"
msgid "HLS stream is back online. Resuming HLS"
msgstr "Luồng HLS đã online trở lại. Đang tiếp tục phát"
